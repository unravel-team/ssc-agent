# Copy to intel_api/.env and fill in. intel_api/.env holds secrets: it is gitignored; keep it readable by the deploy user only.

# Database password (letters and digits only, it goes into a URL):  openssl rand -hex 24
POSTGRES_PASSWORD=

# API keys, "role:key" separated by commas. Make each key with:  openssl rand -hex 32
#   read (lookups) < write (+ breach notices) < admin (+ run jobs, see every scan)
#   scan: a laptop scanner (send scans, read its own results). Optional: laptops get their own scan keys from
#         POST /v1/register unless SSC_SELF_REGISTER=0; add "scan:<key>" here only for keys you hand out yourself.
SSC_INTEL_API_KEYS=read:CHANGE_ME,write:CHANGE_ME,admin:CHANGE_ME

# Laptops registering their own scan keys: 1 = on (default), 0 = off; and how many new keys are allowed
SSC_SELF_REGISTER=1
SSC_REGISTER_PER_CLIENT_HOUR=10
SSC_REGISTER_PER_DAY=200

# The agents container: its own key (added to the API's keys as an "agent" key; nothing else gets it)
SSC_AGENT_KEY=
# Claude for the agents: a Console API key, or a token from `claude setup-token` (your Claude subscription)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Spending cap per advisory (USD), and an optional model
SSC_AGENT_BUDGET_USD=3
SSC_AGENT_MODEL=
# The support check: a separate run that checks each claim of the advisory against its facts
SSC_VERIFY_MODEL=claude-opus-5-5
SSC_VERIFY_BUDGET_USD=0.5

# Optional source credentials (more sources and higher rate limits)
GITHUB_TOKEN=
NVD_API_KEY=
VULNCHECK_API_KEY=
X_BEARER_TOKEN=
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Ports nginx listens on (host side)
HTTPS_PORT=443
HTTP_PORT=80