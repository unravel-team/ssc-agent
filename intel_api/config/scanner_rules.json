  "secretish": "(KEY|TOKEN|SECRET|PASSWORD|PASSWD|PASS|DSN|CREDENTIAL|PRIVATE|AUTH|_URL|_URI|CONN)",
  "not_secret": "^(NODE_ENV|PATH|HOME|PORT|HOST|DEBUG|LOG_LEVEL|ENV|ENVIRONMENT|PYTHONPATH|TZ|CI|PUBLIC_URL|BASE_URL|FRONTEND_URL|API_URL)$",
  "registry_hosts": [
    {
      "pattern": "^ghcr\\.io/",
      "vendor": "GitHub Container Registry"
    },
    {
      "pattern": "\\.dkr\\.ecr\\.[^/]+\\.amazonaws\\.com/",
      "vendor": "AWS ECR"
    },
    {
      "pattern": "^(gcr\\.io|[a-z0-9-]+-docker\\.pkg\\.dev)/",
      "vendor": "Google Artifact Registry"
    },
    {
      "pattern": "^mcr\\.microsoft\\.com/",
      "vendor": "Microsoft Container Registry"
    },
    {
      "pattern": "^quay\\.io/",
      "vendor": "Quay"
    },
    {
      "pattern": "^public\\.ecr\\.aws/",
      "vendor": "AWS Public ECR"
    },
    {
      "pattern": "^cgr\\.dev/",
      "vendor": "Chainguard"
    }
  ],
  "secret_patterns": [
    {
      "kind": "Anthropic API key",
      "severity": "CRITICAL",
      "pattern": "sk-ant-(?:api|admin)\\d{2}-[A-Za-z0-9_\\-]{20,}"
    },
    {
      "kind": "OpenAI API key",
      "severity": "CRITICAL",
      "pattern": "sk-(?:proj-|svcacct-)?[A-Za-z0-9_\\-]{30,}"
    },
    {
      "kind": "Google API key",
      "severity": "HIGH",
      "pattern": "AIza[0-9A-Za-z_\\-]{30,}"
    },
    {
      "kind": "AWS access key ID",
      "severity": "CRITICAL",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
    },
    {
      "kind": "AWS secret access key",
      "severity": "CRITICAL",
      "pattern": "(?i)aws_secret_access_key\\s*[=:]\\s*['\\\"]?[A-Za-z0-9/+]{40}"
    },
    {
      "kind": "GitHub token",
      "severity": "CRITICAL",
      "pattern": "\\b(?:ghp|gho|ghs|ghu|github_pat)_[A-Za-z0-9_]{30,}"
    },
    {
      "kind": "Hugging Face token",
      "severity": "HIGH",
      "pattern": "\\bhf_[A-Za-z0-9]{30,}"
    },
    {
      "kind": "Stripe secret key",
      "severity": "CRITICAL",
      "pattern": "(?:sk|rk)_live_[A-Za-z0-9]{24,}"
    },
    {
      "kind": "Database URL with password",
      "severity": "HIGH",
      "pattern": "\\b(?:postgres|postgresql|mysql|mongodb(?:\\+srv)?)://[^:\\s/]+:[^@\\s]+@[^\\s'\\\"]+"
    },
    {
      "kind": "Private key",
      "severity": "CRITICAL",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"
    }
  ],
  "secret_placeholder": "(?i)example|dummy|fake|placeholder|xxxx",
  "secret_skip_dirs": [
    ".git",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv"
  ],
  "import_aliases": {
    "$comment": "Python modules whose import name is not their PyPI name (import name -> PyPI name). Without an entry the names are compared as they are, after lowercasing and treating - _ . alike, and without a python-/py- prefix or -python/-py suffix. Used by the scanners to tell whether a dependency is used (imported, or started by a run command).",
