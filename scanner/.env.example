# Settings for the ssc scanner. Copy to scanner/.env (it is gitignored) and fill in.
# The app finds this file next to its binary or up to three folders above it (so scanner/.env when run from the
# project), or at ~/.ssc/.env; or point at it with --env FILE / SSC_ENV. Background scans use the same file.

# The company's sources API. Its HTTPS certificate must be one this computer already trusts (the company's
# internal CA, which IT installs on laptops, or a public one). For the local test stack: http://127.0.0.1:8787
SSC_API_URL=https://intel.yourcompany.internal
# Optional: a scan key you were given. Leave it empty and the app gets its own from the server (saved in ~/.ssc/key).
SSC_API_KEY=

# Optional: folders to scan (comma separated; ~ is your home folder). Folders can also be added in the app.
SSC_FOLDERS=
